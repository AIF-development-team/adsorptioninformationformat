# N2 adsorption on activated carbon at 77 K with measurement uncertainties

data_n2_activated_carbon_uncertainty

    _audit_aif_version                "__AIF_VERSION__"

    _exptl_operator                   "Maria Torres"
    _exptl_date                       2025-09-10T11:00:00Z
    _exptl_temperature                77.35
    _exptl_temperature_su             0.15                  # Type A standard uncertainty from triplicate repeat measurements (~0.2 K).
    _exptl_method                     "volumetric"
    _exptl_instrument                 "ASAP-2020-HD"
    _exptl_isotherm_type              "absolute"

    _adsnt_material_name              "Activated Carbon BPL"
    _adsnt_sample_name                "BPL-lot3-01"
    _adsnt_sample_mass                0.1012

    _adsorptive_name                  "Nitrogen"
    _adsorptive_cas                   "7727-37-9"

    _units_temperature                "K"
    _units_pressure                   "Pa"
    _units_mass                       "g"
    _units_sorbed_amount              "mmol/g"

    # Adsorption branch.
    
    # _adsorp_amount_uncertainty : expanded uncertainty at coverage factor k=2 (95 % confidence level).
    loop_
        _adsorp_index
        _adsorp_pressure
        _adsorp_p0
        _adsorp_amount
        _adsorp_amount_su                                   # Type B standard uncertainty from instrument calibration.
        _adsorp_amount_uncertainty                          # expanded uncertainty at coverage factor k=2 (95 % confidence level).
