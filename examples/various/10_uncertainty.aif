        7  70000.0    101325.0   22.30  0.22    0.44
        8  90000.0    101325.0   24.80  0.25    0.50
        9  95000.0    101325.0   26.10  0.26    0.52

    loop_
        _desorp_index
        _desorp_pressure
        _desorp_p0
        _desorp_amount
        _desorp_amount_su                                   # Type A standard uncertainty from triplicate repeat measurements (~1 %).
        _desorp_amount_uncertainty                          # expanded uncertainty at coverage factor k=2 (95 % confidence level).
        1  95000.0    101325.0   26.10   0.26   0.52
