    _units_temperature                "K"
    _units_pressure                   "kPa"
    _units_mass                       "g"
    _units_loading                    "mmol/g"
    _units_density                    "g/cm3"
    _units_time                       "s"

    _citation_doi                     "10.1234/transient.example"

    # -------------------------------------------------------
