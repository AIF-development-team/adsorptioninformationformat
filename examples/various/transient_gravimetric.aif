# gravimetric adsorption with full transient data (adsorption + desorption)

data_transient_gravimetric_CO2

    _audit_aif_version                "__AIF_VERSION__"

    _exptl_operator                   "Bob Zhang"
    _exptl_date                       2026-03-01T14:00:00Z
    _exptl_adsorptive                 "Carbon dioxide"
    _exptl_adsorptive_name            "CO2"
    _exptl_temperature                298.15
    _exptl_method                     "gravimetric"
    _exptl_instrument                 "TA Instruments VTI-SA+"
    _exptl_isotherm_type              "excess"

    _adsnt_material_id                "Zeolite-13X"
