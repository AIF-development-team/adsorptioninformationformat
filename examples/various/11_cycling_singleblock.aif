# Cycling AIF: To demonstrate multiple adsorption cycles in a single AIF file
# The adsorption loop uses the _adsorp_cycle_index column to identify which
#  cycle the measurement belongs
# NOTE: Contains a near-minimal set of AIF key-value pairs

data_cycling_aif_cycle

    _audit_aif_version                "__AIF_VERSION__"

    _exptl_operator                   "Daniel Siderius"
    _exptl_date                       2026-11-10T09:00:00Z
    _exptl_temperature                300.0
    _exptl_method                     "volumetric"
    _exptl_isotherm_type              "excess"

    _adsnt_material_name              "Test Adsorbent"

    _adsorptive_name                  "Carbon Dioxide"
    _adsorptive_info                  "CO2"

    _units_temperature                "K"
    _units_pressure                   "KiloPa"
    _units_sorbed_amount              "mmol/g"

    loop_
        _adsorp_index
        _adsorp_pressure
        _adsorp_amount
        _adsorp_cycle_index
       1    0.0    0.0   1
       2    1.0    1.5   1
       3    2.0    3.0   1
       4    3.0    4.5   1
       5    4.0    6.0   1
       6    3.0    4.5   1
       7    2.0    3.0   1
       8    1.0    1.5   1
       9    0.0    0.0   1
      10    1.0    1.4   2
      11    2.0    2.8   2
      12    3.0    4.2   2
      13    4.0    5.6   2
      14    3.0    4.2   2
      15    2.0    2.8   2
      16    1.0    1.4   2
      17    0.0    0.0   2
      18    1.0    1.4   3
      19    2.0    2.7   3
      20    3.0    4.1   3
      21    4.0    5.4   3
      22    3.0    4.1   3
      23    2.0    2.7   3
      24    1.0    1.4   3
      25    0.0    0.0   3