    _data_license                     "CC-BY-4.0"
    _data_orcid                       "0000-0001-2345-6789"

    _units_temperature                "K"
    _units_pressure                   "Pa"
    _units_loading                    "mmol/g"

    loop_
        _adsorp_pressure
        _adsorp_amount
        100.0      0.012
        500.0      0.058
        1000.0     0.115
        5000.0     0.545
        10000.0    1.023
        25000.0    2.189
        50000.0    3.456
        75000.0    4.234
        100000.0   4.789

