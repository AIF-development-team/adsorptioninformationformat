    loop_
        _fit_param_id
        _fit_param_name
        _fit_param_value
        _fit_param_uncertainty
        _fit_param_unit
        1  "q_max"  5.67   0.12   "mmol/g"
        1  "K"      0.0023 0.0001 "1/Pa"