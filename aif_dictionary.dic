##############################################################################

save_AUDIT
    _definition.id               AUDIT
    _definition.scope            Category
    _definition.class            Set
    _definition.update           2026-03-09
    _description.text
;
    Data items in the audit category record version and format
    tracking. Required for every AIF file.
;
    _name.category_id            AIF_CORE
    _name.object_id              AUDIT
save_

save_audit.aif_version
    _definition.id               'audit.aif_version'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text            'Version of the AIF data-name dictionary used by this file'
    _name.category_id            AUDIT
    _name.object_id              aif_version
    _type.purpose                Describe
    _type.source                 Assigned
    _type.container              Single
    _type.contents               Text
    _enumeration.default         __AIF_VERSION__
    _description.common
;
    Required field.
;
save_

save_audit.author
    _definition.id               'audit.author'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Name of the person who created the data block, if different from
    the experiment operator.
;
    _name.category_id            AUDIT
    _name.object_id              author
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_audit.creation_date
    _definition.id               'audit.creation_date'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text            'Date and time the AIF file was created in ISO 8601 format'
    _name.category_id            AUDIT
    _name.object_id              creation_date
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               DateTime
save_

save_audit.creation_method
    _definition.id               'audit.creation_method'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    The method by which the AIF file was created, e.g. 'manual',
    'scripted', 'exported', etc.
;
    _name.category_id            AUDIT
    _name.object_id              creation_method
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_audit.creation_software
    _definition.id               'audit.creation_software'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Name and version of the software used to generate this AIF file
;
    _name.category_id            AUDIT
    _name.object_id              creation_software
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

##############################################################################
