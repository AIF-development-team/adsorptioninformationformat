#\#CIF_2.0

##############################################################################
#                                                                            #
#            ADSORPTION INFORMATION FORMAT (AIF) DDLm DICTIONARY             #
#                                                                            #
##############################################################################

data_AIF_DIC

    _dictionary.title            AIF_DIC
    _dictionary.class            Instance
    _dictionary.version          __AIF_VERSION__
    _dictionary.date             2026-03-09
    _dictionary.uri
        https://github.com/AIF-development-team/adsorptioninformationformat
    _dictionary.ddl_conformance  4.2.0
    _dictionary.namespace        AifDic
    _description.text
;
    Dictionary for STAR format adsorption experiment and simulation data
    files, known as the Adsorption Information Format (AIF).

    Reference:
    Evans, J. D.; Bon, V.; Senkovska, I.; Kaskel, S.
    Langmuir 2021, 37, 4222-4226.
    DOI: 10.1021/acs.langmuir.1c00122
;

##############################################################################
#                                                                            #
#                               AUDIT CATEGORY                               #
#                                                                            #
##############################################################################

save_AUDIT
    _definition.id               AUDIT
    _definition.scope            Category
    _definition.class            Head
    _definition.update           2026-03-09
    _description.text
;
    Data items in the AUDIT category record version and format
    tracking. Required for every AIF file.
;
save_

save_audit.aif_version
    _definition.id               '_audit_aif_version'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text            'Version of the AIF data-name dictionary used by this file'
    _type.purpose                Describe
    _type.source                 Assigned
    _type.container              Single
    _type.contents               Text
    _enumeration.default         __AIF_VERSION__
save_

save_audit.creation_date
    _definition.id               '_audit_creation_date'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text            'Date and time the AIF file was created in ISO 8601 format'
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               DateTime
save_

save_audit.creation_software
    _definition.id               '_audit_creation_software'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Name and version of the software used to generate this AIF file
;
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_audit.digitizer
    _definition.id               '_audit_digitizer'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Name of the person who digitized the data, if extracted from a
    published figure or table
;
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

##############################################################################
#                                                                            #
#                               EXPTL CATEGORY                               #
#                                                                            #
##############################################################################

save_EXPTL
    _definition.id               EXPTL
    _definition.scope            Category
    _definition.class            Set
    _definition.update           2026-03-09
    _description.text
;
    Data items in the EXPTL category record conditions, methods, and
    operator details for the adsorption experiment. These are scalar
    (single-value) metadata fields that describe the overall
    experiment.
;
save_

save_exptl.operator
    _definition.id               '_exptl_operator'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text            'Name of the person who performed the experiment'
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_exptl.date
    _definition.id               '_exptl_date'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text            'Date and time of the experiment in ISO 8601 format'
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               DateTime
save_

save_exptl.instrument
    _definition.id               '_exptl_instrument'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Identifier or model name of the instrument used for the
    measurement
;
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_exptl.temperature
    _definition.id               '_exptl_temperature'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Temperature at which the experiment was conducted (see
    _units_temperature)
;
    _type.purpose                Measurand
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Real
    _units.code                  'see _units_temperature'
save_

save_exptl.method
    _definition.id               '_exptl_method'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text            'Experimental technique used to measure the amount adsorbed'
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
    loop_
        _enumeration_set.state
        _enumeration_set.detail
        volumetric       'Volumetric (manometric) method.'
        gravimetric      'Gravimetric method.'
        chromatographic  'Chromatographic method.'
        simulation       'Data originates from molecular simulation rather than experiment.'
        other            'Other method not specified here.'
save_

save_exptl.isotherm_type
    _definition.id               '_exptl_isotherm_type'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text            'Classification of the reported adsorbed amount'
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
    loop_
        _enumeration_set.state
        _enumeration_set.detail
        absolute         'Absolute adsorption.'
        excess           'Excess adsorption.'
        net              'Net adsorption.'
save_

