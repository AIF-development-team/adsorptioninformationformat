save_exptl.method
    _definition.id               '_exptl_method'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Description of method used to determine amount adsorbed.
;
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
    loop_
        _enumeration_set.state
        _enumeration_set.detail
        volumetric       'Volumetric (manometric) method'
        gravimetric      'Gravimetric method'
save_

save_exptl.isotherm_type
    _definition.id               '_exptl_isotherm_type'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
