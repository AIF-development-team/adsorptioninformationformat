save_DESORP
    _definition.id               DESORP
    _definition.scope            Category
    _definition.class            Loop
    _definition.update           2026-03-09
    _description.text
;
    Data items in the DESORP category record loop columns for the
    desorption branch of the isotherm. Mirrors the adsorption data
    section for the reverse process.
;
save_

save_desorp.pressure
    _definition.id               '_desorp_pressure'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
