#\#CIF_2.0

##############################################################################
#                                                                            #
#            ADSORPTION INFORMATION FORMAT (AIF) DDLm DICTIONARY             #
#                                                                            #
##############################################################################

data_AIF_DIC

    _dictionary.title            AIF_DIC
    _dictionary.class            Instance
    _dictionary.version          __AIF_VERSION__
    _dictionary.date             2026-03-09
    _dictionary.uri
        https://github.com/AIF-development-team/adsorptioninformationformat/tree/__AIF_VERSION__/aif_dictionary.dic
    _dictionary.guide
        https://github.com/AIF-development-team/adsorptioninformationformat/tree/__AIF_VERSION__/dev/SCHEMA.md
    _dictionary.ddl_conformance  4.1.0
    _dictionary.namespace        AIFCore
    _description.text
;
    Adsorption Information Format (AIF): Dictionary for STAR format adsorption data files.

    Reference:
    Evans, J. D.; Bon, V.; Senkovska, I.; Kaskel, S.
    Langmuir 2021, 37, 4222-4226.
    DOI: 10.1021/acs.langmuir.1c00122
;

save_AIF_CORE
    _definition.id               AIF_CORE
    _definition.scope            Category
    _definition.class            Head
    _definition.update           2026-03-09
    _description.text            'Parent category for all AIF data items.'
    _name.category_id            AIF_CORE
    _name.object_id              AIF_CORE
save_

