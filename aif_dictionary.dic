save_SIMLTN
    _definition.id               SIMLTN
    _definition.scope            Category
    _definition.class            Set
    _definition.update           2026-03-09
    _description.text
;
    Data items in the SIMLTN category record computational method
    details for simulated isotherms (e.g. GCMC, MD). Only relevant
    when the data originates from molecular simulation rather than
    experiment. Requires _exptl_method = simulation.
;
save_

save_simltn.code
    _definition.id               '_simltn_code'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Name and version of the simulation software, e.g. RASPA 2.0,
    LAMMPS
;
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_simltn.size
    _definition.id               '_simltn_size'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Description of the simulated system size, e.g. number of unit
    cells or particle count
;
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_simltn.forcefield_adsorptive
    _definition.id               '_simltn_forcefield_adsorptive'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Force field or interaction model used for the adsorptive, e.g.
    TraPPE, OPLS-AA
;
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_simltn.forcefield_adsorbent
    _definition.id               '_simltn_forcefield_adsorbent'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Force field or interaction model used for the adsorbent
    framework, e.g. UFF, DREIDING
;
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_simltn.input_files
    _definition.id               '_simltn_input_files'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    URL or repository link to the simulation input files and scripts
;
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_simltn.sampling
    _definition.id               '_simltn_sampling'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Phase-space sampling method used, e.g. GCMC, MD, Widom insertion
;
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_simltn.lot
    _definition.id               '_simltn_lot'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Level of theory for the calculation, e.g. DFT, machine-learned
    potential, classical force field
;
    _type.purpose                Describe
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_simltn.date
    _definition.id               '_simltn_date'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Date and time of the simulation in ISO 8601 format. This field
    is deprecated and may be removed in future versions of the AIF
