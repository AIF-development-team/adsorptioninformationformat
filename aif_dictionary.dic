    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text
save_

save_adsnt.sample_name
    _definition.id               '_adsnt_sample_name'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Unique sample identifier assigned by the operator or laboratory
;
    _type.purpose                Key
    _type.source                 Assigned
    _type.container              Single
    _type.contents               Text
    _description.common
;
    A unique identifier for the specific sample used in the
    experiment.
;
save_

