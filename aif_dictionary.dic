    _description.text
;
    Data items in the ADSNT category record identification, physical
    properties, and degassing conditions for the adsorbent material.
;
save_

save_adsnt.material_id
    _definition.id               '_adsnt_material_id'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-03-09
    _description.text
;
    Name or designation of the adsorbent material, e.g. UiO-66,
    Zeolite-13X
;
    _type.purpose                Encode
    _type.source                 Assigned
    _type.container              Single
    _type.contents               Text
    _description.common
;
    Required field. The name of the material, e.g. the common name,
    CSD refcode, or other standard identifier.
;
save_

save_adsnt.info
    _definition.id               '_adsnt_info'
    _definition.scope            Item
